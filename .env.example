# Copy to .env for local development. .env is gitignored. Placeholder values only:
# never put real credentials here or reuse these anywhere but your own machine.

# --- docker compose: Postgres + pgvector ---
POSTGRES_USER=caselens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=caselens
POSTGRES_PORT=5432

# --- docker compose: MinIO (local S3-compatible stand-in for GCS) ---
MINIO_ROOT_USER=caselens
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=caselens-evidence

# --- application ---
CASELENS_ENVIRONMENT=local
CASELENS_DATABASE_URL=postgresql+psycopg://caselens:change-me-local-only@127.0.0.1:5432/caselens
# Use 127.0.0.1, not localhost: on Windows + Docker Desktop, localhost resolves to ::1 and hangs.
# Used by `make test` for the migration + RLS tests (separate DB created by compose init).
CASELENS_TEST_DATABASE_URL=postgresql+psycopg://caselens:change-me-local-only@127.0.0.1:5432/caselens_test
