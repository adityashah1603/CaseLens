# Copy to .env for local development. .env is gitignored. Placeholder values only:
# never put real credentials here or reuse these anywhere but your own machine.

# --- docker compose: Postgres + pgvector ---
POSTGRES_USER=caselens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=caselens
POSTGRES_PORT=5432

# --- docker compose: MinIO (local S3-compatible stand-in for GCS) ---
MINIO_ROOT_USER=caselens
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=caselens-evidence

# --- application ---
CASELENS_ENVIRONMENT=local
CASELENS_DATABASE_URL=postgresql+psycopg://caselens:change-me-local-only@127.0.0.1:5432/caselens
# Use 127.0.0.1, not localhost: on Windows + Docker Desktop, localhost resolves to ::1 and hangs.
# Used by `make test` for the migration + RLS tests (separate DB created by compose init).
CASELENS_TEST_DATABASE_URL=postgresql+psycopg://caselens:change-me-local-only@127.0.0.1:5432/caselens_test

# --- ingest workers (MinIO credentials = the MINIO_ROOT_* values above, local only) ---
CASELENS_S3_ENDPOINT=127.0.0.1:9000
CASELENS_S3_ACCESS_KEY=caselens
CASELENS_S3_SECRET_KEY=change-me-local-only
CASELENS_BUCKET=caselens-evidence
CASELENS_MODEL_CACHE_DIR=.cache/models

# --- model router (packages/agent/caselens_agent/router.py) ---
# gemini = Google AI Studio free tier (key from https://aistudio.google.com/apikey); ollama = local.
CASELENS_LLM_PROVIDER=gemini
CASELENS_GEMINI_API_KEY=

# --- API auth ---
# Local-only dev tokens (HS256). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rejected (app refuses to start) unless CASELENS_ENVIRONMENT=local.
CASELENS_DEV_AUTH_SECRET=
# Firebase project for real ID tokens (Week 6 deploy).
CASELENS_FIREBASE_PROJECT_ID=
