# Copy to .env.local (gitignored) and fill in. Never commit real tokens.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Dev tokens minted by: python -m caselens_api seed-dev-users  (local only)
VITE_DEV_TOKEN_LEAD=
VITE_DEV_TOKEN_ANALYST=
VITE_DEV_TOKEN_VIEWER=
# Firebase web config (Week 6). Leave blank to hide Firebase sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
