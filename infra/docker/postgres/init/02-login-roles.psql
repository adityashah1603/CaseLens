-- Local dev only (SYNTHETIC data): dedicated, least-privilege database logins so neither the API
-- nor the workers log in as the owner superuser. Idempotent: safe to run again at any time.
--
-- Needs psql variables api_password and worker_password. On a fresh volume 02-login-roles.sh
-- runs it from docker-entrypoint-initdb.d; to apply it to an existing volume, see
-- apps/api/README.md ("Database logins"). Migrations still run as the owner (alembic).
\set ON_ERROR_STOP on

-- Refuse empty passwords (an undefined variable is a syntax error below, which also stops).
SELECT (:'api_password' = '' OR :'worker_password' = '') AS missing_password \gset
\if :missing_password
DO $$ BEGIN RAISE EXCEPTION 'psql variables api_password and worker_password must be non-empty'; END $$;
\endif

-- (a) Group roles, with the same attributes as migration 0001 (which also creates them
-- idempotently). Compose init runs before migrations, so the logins need them to exist now.
SELECT 'CREATE ROLE caselens_app NOLOGIN'
 WHERE NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'caselens_app') \gexec
SELECT 'CREATE ROLE caselens_readonly NOLOGIN'
 WHERE NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'caselens_readonly') \gexec
SELECT 'CREATE ROLE caselens_worker NOLOGIN BYPASSRLS'
 WHERE NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'caselens_worker') \gexec
ALTER ROLE caselens_app NOLOGIN NOBYPASSRLS;
ALTER ROLE caselens_readonly NOLOGIN NOBYPASSRLS;
ALTER ROLE caselens_worker NOLOGIN BYPASSRLS;

-- (b) Login roles. NOINHERIT: a login holds no privileges of its own until it runs SET ROLE to
-- one of its group roles (the API and workers do that on every connection).
SELECT 'CREATE ROLE caselens_api_login'
 WHERE NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'caselens_api_login') \gexec
SELECT 'CREATE ROLE caselens_worker_login'
 WHERE NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'caselens_worker_login') \gexec
ALTER ROLE caselens_api_login LOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE
  NOREPLICATION NOINHERIT PASSWORD :'api_password';
ALTER ROLE caselens_worker_login LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
  NOREPLICATION NOINHERIT PASSWORD :'worker_password';

-- Memberships: the API login is a member of caselens_app and caselens_readonly only, the worker
-- login of caselens_worker only. Any other membership is revoked.
GRANT caselens_app, caselens_readonly TO caselens_api_login WITH INHERIT FALSE, SET TRUE;
GRANT caselens_worker TO caselens_worker_login WITH INHERIT FALSE, SET TRUE;
SELECT format('REVOKE %I FROM %I', g.rolname, u.rolname)
  FROM pg_catalog.pg_auth_members AS am
  JOIN pg_catalog.pg_roles AS g ON g.oid = am.roleid
  JOIN pg_catalog.pg_roles AS u ON u.oid = am.member
 WHERE (u.rolname = 'caselens_api_login'
        AND g.rolname NOT IN ('caselens_app', 'caselens_readonly'))
    OR (u.rolname = 'caselens_worker_login' AND g.rolname <> 'caselens_worker') \gexec

SELECT r.rolname, r.rolsuper, r.rolbypassrls, r.rolinherit,
       array(SELECT g.rolname FROM pg_catalog.pg_auth_members AS am
               JOIN pg_catalog.pg_roles AS g ON g.oid = am.roleid
              WHERE am.member = r.oid ORDER BY 1) AS member_of
  FROM pg_catalog.pg_roles AS r
 WHERE r.rolname IN ('caselens_api_login', 'caselens_worker_login')
 ORDER BY 1;
